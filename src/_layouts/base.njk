<!doctype html>
<html lang="{{ pageLang or site.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f6f3ed" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1b1916" media="(prefers-color-scheme: dark)">
    {% set pageTitle %}{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.seoTitle or site.title }}{% endif %}{% endset %}
    {% set pageDescription = description or site.tagline %}
    {% set pageUrl = site.baseUrl + page.url %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ pageUrl }}">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:image" content="{{ site.baseUrl }}{{ site.ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ site.ogImageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ site.baseUrl }}{{ site.ogImage }}">
    <meta name="twitter:image:alt" content="{{ site.ogImageAlt }}">
    {% if noindex or site.draft %}<meta name="robots" content="noindex">{% endif %}
    {% if page.url == "/" %}{% include "jsonld.njk" %}{% endif %}
    <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {% if site.draft %}<div class="draft-banner" role="note">DRAFT · not published · legal texts under review</div>{% endif %}
    {% include "header.njk" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "footer.njk" %}
</body>
</html>
