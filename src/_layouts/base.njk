<!doctype html>
<html lang="{{ pageLang or site.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f6f3ed" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1b1916" media="(prefers-color-scheme: dark)">
    {% set pageTitle %}{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}{% endset %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ description or site.tagline }}">
    <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ description or site.tagline }}">
    <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}">
    {% if noindex or site.draft %}<meta name="robots" content="noindex">{% endif %}
    <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {% if site.draft %}<div class="draft-banner" role="note">DRAFT · not published · legal texts under review</div>{% endif %}
    {% include "header.njk" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "footer.njk" %}
</body>
</html>
