<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ site.title }}</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ site.baseUrl }}{{ redirectTo }}">
<meta http-equiv="refresh" content="0; url={{ redirectTo }}">
<script>location.replace({{ redirectTo | dump | safe }} + location.search + location.hash);</script>
</head>
<body>
<p>This page has moved to <a href="{{ redirectTo }}">{{ site.baseUrl }}{{ redirectTo }}</a>.</p>
</body>
</html>
