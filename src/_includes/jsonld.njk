{#- Structured data for the home pages (EN "/" and DE "/de/"). No App Store parts yet (no app ID): add downloadUrl,
    offers and the App Store link in sameAs only once the app is listed. sameAs gets the
    Instagram and YouTube profiles once those accounts exist. -#}
{%- set isDe = (pageLang == "de") -%}
{%- set ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": site.baseUrl + "/#organization",
      "name": site.title,
      "url": site.baseUrl + "/",
      "logo": site.baseUrl + site.logo,
      "email": site.contactEmail
    },
    {
      "@type": "WebSite",
      "@id": site.baseUrl + "/#website",
      "name": site.title,
      "url": site.baseUrl + "/",
      "inLanguage": ["en", "de"],
      "publisher": { "@id": site.baseUrl + "/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": site.baseUrl + "/#app",
      "name": site.title,
      "operatingSystem": "iOS",
      "applicationCategory": "LifestyleApplication",
      "inLanguage": ("de" if isDe else "en"),
      "description": ("Eine qualitative Simulation von Raumluft und Wänden für iPhone. Sie zeigt einen Schnitt durch einen Raum: wie sich warme und kühle Luft im Modell bewegt und wie kühl die Wandoberfläche wird." if isDe else "A qualitative simulation of room air and walls for iPhone. It shows a section through a room: how warm and cool air move in the model and how cool the wall surface gets."),
      "url": site.baseUrl + ("/de/" if isDe else "/"),
      "image": site.baseUrl + ("/assets/img/og-card-de.png" if isDe else site.ogImage),
      "publisher": { "@id": site.baseUrl + "/#organization" }
    }
  ]
} -%}
<script type="application/ld+json">{{ ld | dump | safe }}</script>
