<script>
// Random order of the equal-ranked cards on each visit, one card per view. No cookie, no storage, nothing is sent.
(function () {
    var c = document.getElementById("cards");
    if (!c) { return; }
    var k = Array.prototype.slice.call(c.children);
    for (var i = k.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = k[i]; k[i] = k[j]; k[j] = t;
    }
    k.forEach(function (e) { c.appendChild(e); });
})();
// Hero clip: plays only on request, once, no loop. Nothing is stored or sent.
